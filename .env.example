# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Security Token (Auto-generated on first run or set manually)
ASTRA_AUTH_TOKEN=generate_or_leave_empty_for_auto

# Assistant Voice Settings
# Hindi voices: hi-IN-SwaraNeural, hi-IN-MadhurNeural
# English voices: en-IN-NeerjaNeural, en-IN-PrabhatNeural
VOICE_HINDI=hi-IN-SwaraNeural
VOICE_ENGLISH=en-IN-NeerjaNeural

# Server Settings (Default: 127.0.0.1 for local security)
HOST=127.0.0.1
PORT=8000
